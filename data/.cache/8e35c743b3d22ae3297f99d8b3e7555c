		<title>Ore Energy Raises $43 Million to Build Lasting Rust Batteries for the AI Era</title>
		<link>https://ventureburn.com/ore-energy-raises-43-million-series-a-for-iron-air-batteries/</link>
		
		<dc:creator><![CDATA[Ekemini]]></dc:creator>
		<pubDate>Tue, 04 Aug 2026 11:50:03 +0000</pubDate>
				<category><![CDATA[AI]]></category>
		<category><![CDATA[News]]></category>
