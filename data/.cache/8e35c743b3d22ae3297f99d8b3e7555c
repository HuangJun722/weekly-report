		<title>Ominimo Raises $22.5 Million at $1.6 Billion Valuation</title>
		<link>https://ventureburn.com/ominimo-raises-22-5-million-series-b/</link>
		
		<dc:creator><![CDATA[Clinton]]></dc:creator>
		<pubDate>Mon, 27 Jul 2026 13:29:03 +0000</pubDate>
				<category><![CDATA[News]]></category>
