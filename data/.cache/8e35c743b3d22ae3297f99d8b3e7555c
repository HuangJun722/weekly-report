		<link>https://ventureburn.com/river-mobility-raises-120-million-to-scale-indias-utility-ev-market/</link>
		
		<dc:creator><![CDATA[Ekemini]]></dc:creator>
		<pubDate>Wed, 05 Aug 2026 15:11:11 +0000</pubDate>
				<category><![CDATA[News]]></category>
		<category><![CDATA[Startup]]></category>
		<category><![CDATA[electric vehicles]]></category>
		<category><![CDATA[EVs]]></category>
