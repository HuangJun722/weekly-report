		<title>Freehand Raises $75 Million as AI Agents Take Up Meta and Unilever’s Supply Chains</title>
		<link>https://ventureburn.com/freehand-raises-75-million-ai-agents-supply-chain/</link>
		
		<dc:creator><![CDATA[Ekemini]]></dc:creator>
		<pubDate>Wed, 29 Jul 2026 17:59:17 +0000</pubDate>
				<category><![CDATA[AI]]></category>
