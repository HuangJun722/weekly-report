		<title>Revoy Raises $27 Million to Turn Old Diesel Trucks Into Hybrids</title>
		<link>https://ventureburn.com/revoy-raises-27-million-electric-truck-dolly/</link>
		
		<dc:creator><![CDATA[Ekemini]]></dc:creator>
		<pubDate>Fri, 31 Jul 2026 12:01:13 +0000</pubDate>
				<category><![CDATA[News]]></category>
