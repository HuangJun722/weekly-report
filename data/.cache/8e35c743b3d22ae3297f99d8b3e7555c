		<title>Hush Security Raises $30 Million To Close the Governance Gap for AI Agent </title>
		<link>https://ventureburn.com/hush-security-raises-30m-ai-agent-governance-gap/</link>
		
		<dc:creator><![CDATA[Ekemini]]></dc:creator>
		<pubDate>Tue, 28 Jul 2026 15:48:23 +0000</pubDate>
				<category><![CDATA[AI]]></category>
		<category><![CDATA[News]]></category>
		<category><![CDATA[Startup]]></category>
		<category><![CDATA[Agentic AI]]></category>
		<category><![CDATA[AI agents]]></category>
