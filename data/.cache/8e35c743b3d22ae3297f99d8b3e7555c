		<title>Convex Raises $57M To Build Reliable AI-Native Backend Platform</title>
		<link>https://ventureburn.com/convex-raises-57m-series-b/</link>
		
		<dc:creator><![CDATA[Clinton]]></dc:creator>
		<pubDate>Tue, 04 Aug 2026 21:30:33 +0000</pubDate>
