		<title>Google Shakes Up AI Leadership, Demis Hassabis Steps Down As DeepMind CEO</title>
		<link>https://ventureburn.com/google-ai-leadership-shuffle-hassabis-jeff-dean/</link>
		
		<dc:creator><![CDATA[Ekemini]]></dc:creator>
		<pubDate>Thu, 06 Aug 2026 12:57:51 +0000</pubDate>
				<category><![CDATA[AI]]></category>
