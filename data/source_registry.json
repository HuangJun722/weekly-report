{
  "version": "2026-08-05",
  "principles": [
    "信源优先解决质量，而不是靠过滤弥补泛新闻噪声。",
    "每个自动接入源都要标注赛道、信号类型、质量层级、抓取方式和风险。",
    "官方、开发者、商户、广告、支付、市场政策类源优先于泛科技新闻流。",
    "候选源先进入观察池，样本质量稳定后再进入自动采集。",
    "研报源只承载可核验的发布事实和有归属的机构判断，不因来源名称自动放宽范围门槛。"
  ],
  "source_schema": {
    "id": "稳定唯一标识",
    "name": "信源名称",
    "url": "公开入口地址",
    "status": "active / candidate / paused",
    "tier": "L1 / L2 / L3 / L4 / L5",
    "source_type": "newsroom / ir / changelog / jobs / engineering_blog / research_report / industry_media / media",
    "access_method": "rss / atom / html / api / sitemap",
    "region": "主要地区",
    "track": "赛道",
    "signal_types": "该源天然更容易产出的信号类型",
    "entity_focus": "company / infra / fintech / ai / commerce / capital",
    "credibility_score": "1-10，越高越可信",
    "signal_density": "high / medium / low",
    "noise_level": "low / medium / high",
    "scope_industries": "允许进入范围判断的既定行业编码；只能来自站点固定行业清单",
    "scope_regions": "该源允许覆盖的目标区域；事件实际影响区域仍需单独判断",
    "allowed_scope_layers": "regional_policy / industry_change / company_action",
    "freshness_speed": "early / same_day / lagging",
    "dedupe_strategy": "url / title / semantic / entity-time",
    "crawl_cost": "low / medium / expensive",
    "anti_bot_risk": "low / medium / high",
    "publisher_type": "official / research_institution / industry_vertical / venture_media / regional_ecosystem / aggregator",
    "authority_domains": "该源可直接支持的主题域，例如市场规模、政策、产品发布",
    "claim_roles": "release_fact / institutional_assessment / performance_claim / policy_change / company_action",
    "access_level": "open / abstract_only / paid / restricted",
    "methodology_visibility": "visible / partial / hidden"
  },
  "signal_types": {
    "official_disclosure": "公司官方披露、新闻稿、IR 公告",
    "developer_change": "开发者平台、API、SDK、政策和能力变更",
    "merchant_product": "商户、卖家、店铺、履约和本地服务产品变化",
    "ads_monetization": "广告商业化、创作者变现、流量分发规则变化",
    "payment_infra": "支付、收单、风控、清结算、钱包和 BNPL",
    "marketplace_policy": "电商、平台、应用商店和市场规则变化",
